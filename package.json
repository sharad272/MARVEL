{
  "name": "marvelverse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:generate": "prisma generate",
    "seed": "tsx scripts/seed.ts && node scripts/generate-db-blob.mjs",
    "sync": "tsx scripts/sync.ts",
    "poll": "tsx scripts/poll-availability.ts",
    "scan": "tsx scripts/scan-media.ts",
    "worker": "tsx scripts/worker.ts",
    "refresh": "tsx scripts/refresh-catalog.ts",
    "refresh:force": "tsx scripts/refresh-catalog.ts --force",
    "check:llm": "tsx scripts/check-llm.ts",
    "check:trailers": "tsx scripts/check-trailer-keys.mjs",
    "check:art": "tsx scripts/check-missing-art.mjs",
    "setup": "npm run db:generate && npm run db:push && npm run seed"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "hls.js": "^1.5.18",
    "lucide-react": "^0.469.0",
    "next": "^15.1.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.11",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
