# ---- Database ----
DATABASE_URL="file:./dev.db"

# ---- TMDB (free: https://www.themoviedb.org/settings/api) ----
# Used for catalog metadata, posters, official trailers and legal
# streaming availability. The app ships with a curated seed catalog and
# works without this, but you get no artwork or availability data.
TMDB_API_KEY=""

# ---- Hugging Face Inference Providers — powers the LLM features ----
# Token: https://huggingface.co/settings/tokens (enable Inference Providers)
HF_TOKEN=""
HF_BASE_URL="https://router.huggingface.co/v1"
LLM_MODEL="openai/gpt-oss-120b"

# ---- Availability region (ISO 3166-1) ----
# Drives the "where to watch" provider list. IN, US, GB, ...
WATCH_REGION="IN"

# ---- Local media (optional) ----
# Absolute path to a folder of media you legally own. The scanner walks
# this folder and matches files to catalog titles.
LOCAL_MEDIA_ROOT=""
